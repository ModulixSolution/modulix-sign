<% if Docuseal.demo? || (request.path != '/' && !devise_controller?) %>
  <meta name="robots" content="noindex">
<% end %>
<% title = content_for(:html_title) || (signed_in? ? 'Modulix Sign' : 'Modulix Sign | Document Signing') %>
<% description = content_for(:html_description) || 'Sign documents securely with Modulix.' %>
<meta name="description" content="<%= description %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:type" content="website">
<meta property="og:url" content="<%= request.base_url + request.path %>">
<meta property="og:site_name" content="Modulix Sign">
<% if content_for(:disable_image_preview) %>
  <meta property="og:image" content="">
  <meta name="twitter:image" content="">
<% else %>
  <meta property="og:image" content="<%= content_for(:preview_image_url).presence || "#{root_url}og-image.png?v=2" %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:alt" content="Modulix Sign">
  <meta name="twitter:image" content="<%= content_for(:preview_image_url).presence || "#{root_url}og-image.png?v=2" %>">
<% end %>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
<link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<meta name="color-scheme" content="light only">
<meta name="theme-color" content="#ffffff">
